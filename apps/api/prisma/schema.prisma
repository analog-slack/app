generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @db.Uuid
  email               String                @unique @db.VarChar(255)
  username            String                @unique @db.VarChar(100)
  passwordHash        String                @map("password_hash")
  avatarUrl           String?               @map("avatar_url")
  isActive            Boolean?              @default(true) @map("is_active")
  createdAt           DateTime?             @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?             @map("updated_at") @db.Timestamp(6)
  ownedWorkspaces     Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers    WorkspaceMember[]
  invitationsSent     WorkspaceInvitation[] @relation("InvitationInviter")
  createdTeams        Team[]                @relation("TeamCreator")
  teamMembers         TeamMember[]
  createdProjects     Project[]             @relation("ProjectCreator")
  projectMembers      ProjectMember[]
  createdChannels     Channel[]             @relation("ChannelCreator")
  channelMembers      ChannelMember[]
  conversationMembers ConversationMember[]
  sentMessages        Message[]             @relation("MessageSender")
  messageReactions    MessageReaction[]
  createdTasks        Task[]                @relation("TaskCreator")
  assignedTasks       Task[]                @relation("TaskAssignee")
  taskChanges         TaskHistory[]         @relation("TaskChangedBy")

  @@map("users")
}

model Workspace {
  id            String                @id @db.Uuid
  name          String                @db.VarChar(150)
  slug          String                @unique @db.VarChar(150)
  ownerId       String                @map("owner_id") @db.Uuid
  createdAt     DateTime?             @map("created_at") @db.Timestamp(6)
  owner         User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  teams         Team[]
  projects      Project[]
  conversations Conversation[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String?   @default("member") @db.VarChar(30)
  joinedAt    DateTime? @map("joined_at") @db.Timestamp(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  invitedBy   String    @map("invited_by") @db.Uuid
  email       String    @db.VarChar(255)
  tokenHash   String    @unique @map("token_hash")
  status      String?   @default("pending") @db.VarChar(30)
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime? @map("created_at") @db.Timestamp(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviter     User      @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("workspace_invitations")
}

model Team {
  id          String       @id @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String       @db.VarChar(150)
  description String?
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime?    @map("created_at") @db.Timestamp(6)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     User         @relation("TeamCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members     TeamMember[]
  projects    Project[]

  @@unique([workspaceId, name])
  @@map("teams")
}

model TeamMember {
  id       String    @id @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     String?   @default("member") @db.VarChar(30)
  joinedAt DateTime? @map("joined_at") @db.Timestamp(6)
  team     Team      @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id           String          @id @db.Uuid
  workspaceId  String          @map("workspace_id") @db.Uuid
  teamId       String?         @map("team_id") @db.Uuid
  name         String          @db.VarChar(150)
  description  String?
  createdBy    String          @map("created_by") @db.Uuid
  createdAt    DateTime?       @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?       @map("updated_at") @db.Timestamp(6)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team         Team?           @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator      User            @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members      ProjectMember[]
  channels     Channel[]
  taskStatuses TaskStatus[]
  tasks        Task[]

  @@map("projects")
}

model ProjectMember {
  id        String    @id @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      String?   @default("member") @db.VarChar(30)
  joinedAt  DateTime? @map("joined_at") @db.Timestamp(6)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Channel {
  id          String          @id @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  name        String          @db.VarChar(100)
  description String?
  visibility  String?         @default("public") @db.VarChar(20)
  isArchived  Boolean?        @default(false) @map("is_archived")
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime?       @map("created_at") @db.Timestamp(6)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     User            @relation("ChannelCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members     ChannelMember[]
  messages    Message[]

  @@map("channels")
}

model ChannelMember {
  id        String    @id @db.Uuid
  channelId String    @map("channel_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  joinedAt  DateTime? @map("joined_at") @db.Timestamp(6)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([channelId, userId])
  @@map("channel_members")
}

model Conversation {
  id          String               @id @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  type        String               @db.VarChar(20)
  createdAt   DateTime?            @map("created_at") @db.Timestamp(6)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members     ConversationMember[]
  messages    Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime?    @map("joined_at") @db.Timestamp(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id              String            @id @db.Uuid
  channelId       String?           @map("channel_id") @db.Uuid
  conversationId  String?           @map("conversation_id") @db.Uuid
  senderId        String            @map("sender_id") @db.Uuid
  parentMessageId String?           @map("parent_message_id") @db.Uuid
  content         String
  editedAt        DateTime?         @map("edited_at") @db.Timestamp(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamp(6)
  createdAt       DateTime?         @map("created_at") @db.Timestamp(6)
  channel         Channel?          @relation(fields: [channelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sender          User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent          Message?          @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Message[]         @relation("MessageThread")
  reactions       MessageReaction[]
  sourceTask      Task?             @relation("TaskSourceMessage")

  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String    @id @db.Uuid
  messageId String    @map("message_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  emoji     String    @db.VarChar(50)
  createdAt DateTime? @map("created_at") @db.Timestamp(6)
  message   Message   @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model TaskStatus {
  id        String   @id @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(100)
  position  Int
  isDefault Boolean? @default(false) @map("is_default")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks     Task[]

  @@unique([projectId, position])
  @@unique([projectId, name])
  @@unique([projectId, id], map: "task_statuses_project_id_id_key")
  @@map("task_statuses")
}

model Task {
  id              String        @id @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  statusId        String        @map("status_id") @db.Uuid
  sourceMessageId String?       @unique @map("source_message_id") @db.Uuid
  title           String        @db.VarChar(255)
  description     String?
  createdBy       String        @map("created_by") @db.Uuid
  assigneeId      String?       @map("assignee_id") @db.Uuid
  priority        String?       @default("medium") @db.VarChar(20)
  dueDate         DateTime?     @map("due_date") @db.Timestamp(6)
  position        Decimal?      @db.Decimal
  isBlocked       Boolean?      @default(false) @map("is_blocked")
  blockedReason   String?       @map("blocked_reason")
  createdAt       DateTime?     @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?     @map("updated_at") @db.Timestamp(6)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status          TaskStatus    @relation(fields: [projectId, statusId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction, map: "tasks_project_id_status_id_fkey")
  sourceMessage   Message?      @relation("TaskSourceMessage", fields: [sourceMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator         User          @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee        User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  history         TaskHistory[]

  @@map("tasks")
}

model TaskHistory {
  id        String    @id @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  changedBy String    @map("changed_by") @db.Uuid
  fieldName String    @map("field_name") @db.VarChar(100)
  oldValue  String?   @map("old_value")
  newValue  String?   @map("new_value")
  createdAt DateTime? @map("created_at") @db.Timestamp(6)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changer   User      @relation("TaskChangedBy", fields: [changedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("task_history")
}
